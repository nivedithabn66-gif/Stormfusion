# ==============================================================================
# STORMFUSION Frontend Environment Configuration Template (Vite + React)
# ==============================================================================
# In production (e.g. Vercel), set VITE_API_BASE_URL to your deployed Render URL:
# Example: https://stormfusion-api.onrender.com/api
# In local development: http://localhost:8000/api

VITE_API_BASE_URL=http://localhost:8000/api

# App Mode: 'live' (queries FastAPI backend) or 'demo' (uses fallback when backend asleep)
VITE_APP_MODE=live

# Optional GIS and Map Tile Tokens
VITE_MAPBOX_TOKEN=
