# ==============================================================================
# STORMFUSION Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or set these variables in your
# Render / cloud deployment settings dashboard.
# NEVER commit real credentials or .env files to version control!

# --- Server & Networking Configuration ---
PORT=8000
HOST=0.0.0.0
# Allowed frontend origins (comma-separated for multiple, e.g. https://stormfusion.vercel.app,http://localhost:5173 or * for all)
CORS_ORIGINS=*

# --- Database Configuration (Optional) ---
# Default fallback is local SQLite (data/stormfusion.db) if unset
DATABASE_URL=postgresql://user:password@localhost:5432/stormfusion

# --- EUMETSAT Data Store API Credentials (Optional - for satellite fetching) ---
# Register at https://user.eumetsat.int and obtain Consumer Key & Secret at https://api.eumetsat.int/api-key/
EUMETSAT_CONSUMER_KEY=your_eumetsat_consumer_key_here
EUMETSAT_CONSUMER_SECRET=your_eumetsat_consumer_secret_here

# --- Copernicus Climate Data Store (CDS) API Credentials (Optional - for ERA5) ---
# Register at https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_cds_api_key_here

# --- MOSDAC Credentials (Optional) ---
MOSDAC_USERNAME=your_mosdac_username_here
MOSDAC_PASSWORD=your_mosdac_password_here
